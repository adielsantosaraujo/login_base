DB_NAME=login_base
DB_USER=login_base
DB_PASSWORD=change-me
# Profile do Docker Compose ativado ao subir o ambiente (make up)
PROFILE=local
# Profile do serviço db (Postgres)
PROFILE_DB=local
# Profile do serviço app; "desativado" = não sobe; use "local" para subir a aplicação no Docker
PROFILE_APP=desativado
# Profile do serviço frontend; "desativado" = não sobe; use "local" para subir o frontend no Docker
PROFILE_FRONTEND=local
# Chave de licença do PrimeVue (community/comercial); vazio funciona com aviso no console
VITE_PRIMEUI_LICENSE=
# E-mail do administrador inicial (criado na 1ª inicialização se não existir)
ADMIN_EMAIL=admin@loginbase.local
# Senha do administrador inicial; vazio = não cria o admin (apenas aviso no log)
ADMIN_PASSWORD=
# Liga/desliga o Swagger UI e o /v3/api-docs (padrão: true; false desliga)
# SPRINGDOC_ENABLED=true
# App do frontend (caminho dentro de frontend/) usado pelos serviços frontend e frontend-build
FRONT_APP=seguro/patrimonio
# Nome do app (vite.config.ts usa para definir base: /<nome>/ no build)
FRONT_APP_NOME=patrimonio
